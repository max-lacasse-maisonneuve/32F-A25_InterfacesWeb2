# Activer le module de réécriture
RewriteEngine On

# Définir la base pour les redirections
# Si votre projet est dans un sous-dossier, ajustez cette ligne en conséquence. Si votre dossier est dans htdocs/piscines, utilisez:
# RewriteBase /piscines/
# Cela permet de mettre l'url du fetch comme api/ au lieu de http://localhost:80/api/
RewriteBase /piscines/

# 1. Laisser passer les fichiers et dossiers existants (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Exclure les routes /api/ pour que les fichiers PHP dans api/ soient servis directement
RewriteRule ^api/ - [L,QSA]

# 3. Rediriger tout le reste vers index.php à la racine
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]